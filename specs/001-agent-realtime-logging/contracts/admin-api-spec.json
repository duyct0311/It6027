{
  "openapi": "3.0.3",
  "info": {
    "title": "Malware Scan Server Admin API",
    "version": "1.0.0",
    "description": "REST APIs for Admin authentication, agent status, and scan log queries."
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Admin Login",
        "operationId": "adminLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "token_type": { "type": "string", "example": "bearer" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "username": { "type": "string" },
                        "role": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/logs": {
      "get": {
        "summary": "Query Scan Logs",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "agent_id", "in": "query", "schema": { "type": "string" } },
          { "name": "severity", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "scan_type", "in": "query", "schema": { "type": "string" } },
          { "name": "module", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of scan logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "page": { "type": "integer" },
                    "limit": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ScanLogItem" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "summary": "List Connected Agents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of agents and online status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "agent_id": { "type": "string" },
                      "hostname": { "type": "string" },
                      "ip_address": { "type": "string" },
                      "status": { "type": "string" },
                      "last_seen_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ScanLogItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "agent_id": { "type": "string" },
          "module": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "scan_type": { "type": "string" },
          "severity": { "type": "string" },
          "status": { "type": "string" },
          "time": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
